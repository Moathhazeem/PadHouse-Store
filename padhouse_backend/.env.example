# Server Configuration
PORT=4000
NODE_ENV="development"
APP_URL="https://api.padhouse.ps"

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://padhouse_user:secure_password@localhost:5432/padhouse_db?schema=public"

# Authentication & Security
JWT_SECRET="padhouse_jwt_secret_min_32_characters_long_key_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="padhouse_refresh_token_secret_key_rotation_here"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Gemini AI Integration
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# n8n Workflow Automation
N8N_WEBHOOK_URL="https://n8n.padhouse.ps/webhook"
N8N_WEBHOOK_SECRET="padhouse_n8n_hmac_secret_sha256"

# Supabase Storage (Product media and assets)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="padhouse-products"

# Meta Graph API (Instagram & Facebook Insights)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_PAGE_ACCESS_TOKEN="your_long_lived_page_token"
INSTAGRAM_BUSINESS_ACCOUNT_ID="your_ig_business_id"

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID="padhouse-palestine"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@padhouse-palestine.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
